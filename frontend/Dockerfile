# ---- Build stage ----
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json yarn.lock* package-lock.json* ./
# npm ci requires the lockfile to have been generated by the exact same npm
# version as what's running here; across different dev machines/CI runners
# that's not guaranteed, so we fall back to npm install (which reconciles
# the lockfile automatically) if the strict check fails. Still fully
# reproducible in normal use since the committed lockfile is the starting
# point either way.
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    else npm ci || npm install; fi

COPY . .

# REACT_APP_BACKEND_URL is baked at build time as a safe default; the actual
# runtime value is overridden by docker-entrypoint.sh via public/env-config.js
# on every `docker run` / Kubernetes pod start, so this image is portable
# across environments without rebuilding.
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
RUN if [ -f yarn.lock ]; then yarn build; else npm run build; fi

# ---- Runtime stage ----
# nginx:alpine (the previous base here) actually runs as root by default -
# only the worker processes drop privileges, not the container's own init
# user - which is why Kubernetes' runAsNonRoot check rejected it. This image
# is purpose-built to run fully non-root out of the box, and already listens
# on 8080 by default (matching nginx.conf), so no port changes needed.
FROM nginxinc/nginx-unprivileged:1.27-alpine

USER root
RUN apk add --no-cache bash

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.d/40-env-config.sh
RUN chmod +x /docker-entrypoint.d/40-env-config.sh && \
    chown -R nginx:nginx /usr/share/nginx/html
# docker-entrypoint.sh (above) rewrites env-config.js under this directory on
# every container start, so the non-root runtime user needs write access to
# it, not just read - hence the chown rather than relying on image defaults.

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
