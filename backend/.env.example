# MongoDB connection string (use AWS DocumentDB or MongoDB Atlas in production)
MONGO_URL=mongodb://localhost:27017
DB_NAME=athe_chat

# JWT
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256

# Comma-separated list of allowed frontend origins (NO wildcard in production)
CORS_ORIGINS=http://localhost:3000

# Number of gunicorn worker processes
WEB_CONCURRENCY=2

# Redis (ElastiCache in AWS) - required for correct WebSocket delivery
# when running more than one backend replica. Leave unset for single-instance
# local development (falls back to in-memory delivery).
REDIS_URL=redis://localhost:6379/0

# Media uploads (images/gifs/audio). Leave S3_BUCKET unset for local dev -
# files are written to backend/media_uploads and served from /media. Set
# both to use S3 (required in production / k8s, since pod disk is ephemeral).
S3_BUCKET=
AWS_REGION=ap-south-1
